<?xml version="1.0" encoding="utf-8"?>
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rootAds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_native_ads"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/ad_call_to_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/dp_12"
            android:layout_marginHorizontal="@dimen/dp_20"
            android:layout_marginTop="@dimen/dp_10"
            android:background="@drawable/bg_button_ads"
            android:gravity="center"
            android:letterSpacing="0.015"
            android:fontFamily="@font/sf_pro_semibold"
            android:textAppearance="@style/BaseTheme.TextRegular"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/sp_16"
            app:layout_constraintTop_toBottomOf="@+id/ad_media"
            tools:text="SIGN UP" />

        <com.google.android.gms.ads.nativead.MediaView
            android:id="@+id/ad_media"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginHorizontal="@dimen/dp_16"
            android:background="@color/white"
            android:layout_marginTop="@dimen/dp_10"
            app:layout_constraintDimensionRatio="H,1.91:1"
            app:layout_constraintTop_toBottomOf="@+id/llHeader"/>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/llHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_8"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="@+id/ad_media"
            app:layout_constraintStart_toStartOf="@+id/ad_media"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="@dimen/dp_22"
                android:layout_height="@dimen/dp_14"
                android:background="@drawable/bg_radius_2"
                android:backgroundTint="#FDB812"
                android:fontFamily="@font/sf_pro_medium"
                android:gravity="center"
                android:text="@string/ad"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/sp_8" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/ad_headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_8"
                android:fontFamily="@font/sf_pro_medium"
                android:textAlignment="center"
                android:textColor="#4B4B4B"
                android:textSize="@dimen/sp_14"
                tools:text="Tiki siêu SALE 11.01 | Shopping" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="@dimen/dp_8"
            app:srcCompat="@drawable/ic_info"
            android:paddingTop="@dimen/dp_3"
            app:layout_constraintTop_toBottomOf="@+id/ad_call_to_action"
            android:visibility="visible"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.gms.ads.nativead.NativeAdView>