<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootHabits"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/selector_bg_item"
    >

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_icon"
        android:layout_width="@dimen/dp_24"
        android:layout_height="@dimen/dp_24"
        android:layout_marginVertical="@dimen/dp_19"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintEnd_toStartOf="@+id/tvEvent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:srcCompat="@drawable/ic_birthday" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvEvent"
        style="@style/BaseTheme.TextRegular"
        android:layout_width="wrap_content"
        android:layout_marginStart="@dimen/dp_12"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:textColor="#222222"
        android:textSize="@dimen/sp_14"
        app:layout_constraintStart_toEndOf="@id/img_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/img_icon"
        app:layout_constraintBottom_toBottomOf="@id/img_icon"
        tools:text="Birthday" />

</androidx.constraintlayout.widget.ConstraintLayout>