<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/rootView"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tool="http://schemas.android.com/tools">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        tool:srcCompat="@drawable/img_my_photo_empty"
        />
    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/BaseTheme.TextRegular"
        android:gravity="center"
        android:textColor="@color/txt_nor_opacity_80"
        android:textSize="@dimen/sp_14"
        android:text="@string/txt_empty_image"
        app:layout_constraintStart_toStartOf="@id/img_empty"
        app:layout_constraintEnd_toEndOf="@id/img_empty"
        app:layout_constraintTop_toBottomOf="@id/img_empty"
        />


</androidx.constraintlayout.widget.ConstraintLayout>